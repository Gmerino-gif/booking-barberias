NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/booking_app?retryWrites=true&w=majority
JWT_SECRET=generate-a-random-secret-with-at-least-32-bytes
CORS_ORIGINS=https://APP_DOMAIN

SMTP_HOST=SMTP_HOST
SMTP_PORT=465
SMTP_USER=SMTP_USER
SMTP_PASS=SMTP_PASSWORD
SMTP_FROM=Booking App <no-reply@YOUR_DOMAIN>

WOMPI_PUBLIC_KEY=
# En producción la llave privada debe iniciar con prv_prod_: la URL base
# (https://production.wompi.co/v1) se deriva de ese prefijo.
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
SUBSCRIPTION_PRICE_COP=29900

# Configura uno de estos secretos, sin subir el archivo JSON al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# Alternativamente, usa el JSON completo en el gestor de secretos del proveedor:
FIREBASE_SERVICE_ACCOUNT_JSON=
