NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/booking_app?retryWrites=true&w=majority
JWT_SECRET=generate-a-random-secret-with-at-least-32-bytes
CORS_ORIGINS=https://APP_DOMAIN

SMTP_HOST=SMTP_HOST
SMTP_PORT=465
SMTP_USER=SMTP_USER
SMTP_PASS=SMTP_PASSWORD
SMTP_FROM=Booking App <no-reply@YOUR_DOMAIN>
