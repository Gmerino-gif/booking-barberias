MONGODB_URI=mongodb://localhost:27017/booking_app
PORT=3000
NODE_ENV=development
JWT_SECRET=
CORS_ORIGINS=

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM=Booking App <no-reply@example.com>

WOMPI_PUBLIC_KEY=
# Llave privada de Wompi: debe iniciar con prv_test_ (sandbox) o prv_prod_
# (producción). La URL base de la API se deriva de ese prefijo, por lo que no
# existe una variable WOMPI_BASE_URL que pueda quedar desincronizada.
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
SUBSCRIPTION_PRICE_COP=39900

# Firebase Admin: usa Application Default Credentials en entornos gestionados.
# En otros entornos, configura una ruta a un secreto fuera del repositorio o
# guarda el JSON de la cuenta de servicio como secreto de entorno.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
